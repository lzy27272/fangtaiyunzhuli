[Unit]
Description=Sifangguan OTA analytics durable spool importer
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/sifangguan-ota/import-analytics-retention.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sifangguan-ota/analytics-retention

