# This file documents variable names only. Generate the real file on the
# server with scripts/bootstrap-ubuntu.sh and never commit its values.
OTA_REVIEW_API_PORT=8091
OTA_REVIEW_USERNAME=review-admin
OTA_REVIEW_PASSWORD=GENERATE_ON_SERVER
OTA_REVIEW_ACCESS_TOKEN=GENERATE_ON_SERVER
OTA_REVIEW_AUTH_STATE_PATH=/data/review-auth-state.json
OTA_REVIEW_AUTH_REFRESH_STATE_PATH=/data/review-auth-sessions.json
OTA_REVIEW_SECURITY_AUDIT_PATH=/data/security-audit.jsonl
OTA_REVIEW_AUTH_COOKIE_PATH=/api/v1/ota-console/auth
OTA_REVIEW_AUTH_COOKIE_SECURE=true
OTA_REVIEW_ALLOWED_ORIGINS=https://www.sfgzt.cn,http://127.0.0.1:15180
OTA_REVIEW_DATA_PATH=/data/report-sources.json
OTA_REVIEW_COOKIE_SECRETS_PATH=/data/report-source-cookie-secrets.json
OTA_REVIEW_SECRET_KEY=GENERATE_ON_SERVER
OTA_REVIEW_PSEUDONYM_SECRET_KEY=GENERATE_ON_SERVER
OTA_REVIEW_AUTO_COLLECTION_ENABLED=true
OTA_REVIEW_TRUSTED_DEVICE_ENABLED=true
OTA_REVIEW_TRUSTED_DEVICE_001_ENABLED=true
OTA_REVIEW_TRUSTED_DEVICE_HOTEL_CODES=001,003,013
OTA_REVIEW_RUNTIME_MODE=LOCAL_LIVE_LONG_RUNNING
  # Optional assisted Luopan reauthentication. The preferred channel is the
  # server-outbound WeCom intelligent-bot long connection configured in the
  # authenticated backend; the public HTTPS URL is only a fallback channel.
  OTA_REVIEW_LUOPAN_ASSISTED_REAUTH_ENABLED=false
OTA_REVIEW_REPAIR_PUBLIC_BASE_URL=https://ota.example.com
# Optional OpenAI-compatible advice enhancement. Keep disabled until the
# endpoint, model and server-only API key have passed a controlled test.
OTA_REVIEW_AI_ENABLED=false
OTA_REVIEW_AI_BASE_URL=https://api.example.com/v1
OTA_REVIEW_AI_MODEL=CONFIGURE_ON_SERVER
OTA_REVIEW_AI_API_KEY_B64=CONFIGURE_ON_SERVER
OTA_REVIEW_AI_TIMEOUT_MS=8000
