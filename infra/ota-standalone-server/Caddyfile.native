{
	auto_https off
	admin off
}

http://127.0.0.1:5180 {
	bind 127.0.0.1

	encode zstd gzip

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@ota_console_exact path /ota-console
	redir @ota_console_exact /ota-console/ 308

	# Both the SSH-tunnel root and public-style subpath serve the app shell.
	# Keep API responses and fingerprinted assets outside this cache policy.
	@ota_console_document {
		not path /assets/* /ota-console/assets/* /api /api/*
	}
	header @ota_console_document Cache-Control "no-cache"

	@ota_console_health path /api/v1/ota-console/health
	handle @ota_console_health {
		rewrite * /health
		reverse_proxy 127.0.0.1:8091
	}

	handle_path /api/v1/ota-console/* {
		rewrite * /api/v1{path}
		reverse_proxy 127.0.0.1:8091
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8091
	}

	handle_path /ota-console/* {
		root * /opt/sifangguan-ota/current/apps/ota-standalone-web/dist
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /opt/sifangguan-ota/current/apps/ota-standalone-web/dist
		try_files {path} /index.html
		file_server
	}
}
