[Unit]
Description=Hotel AI OS Core API
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=hotelai
Group=hotelai
WorkingDirectory=/opt/hotel-ai-os/current

# This file is created on the server with mode 0640 and is never committed.
EnvironmentFile=/etc/hotel-ai-os/core-api.env

# Command-line server options have higher Spring precedence than the environment
# file, so the API cannot be exposed accidentally by an env-file edit.
ExecStartPre=/usr/bin/test -r /opt/hotel-ai-os/current/core-api.jar
ExecStart=/usr/bin/java \
    -Xms512m \
    -Xmx1536m \
    -XX:+ExitOnOutOfMemoryError \
    -jar /opt/hotel-ai-os/current/core-api.jar \
    --server.address=127.0.0.1 \
    --server.port=18080

Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=45s
SuccessExitStatus=143
KillSignal=SIGTERM
UMask=0027

# The release tree and OS stay read-only. Attachments and the private /tmp are
# the only writable locations needed by the current Core API contract.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadWritePaths=/var/lib/hotel-ai-os/attachments

LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=multi-user.target
