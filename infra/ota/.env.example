OTA_POSTGRES_IMAGE=postgres:17-alpine
OTA_FLYWAY_IMAGE=flyway/flyway:12.11.0
OTA_DB_NAME=ota_automation
OTA_DB_PORT=55440
OTA_DB_BOOTSTRAP_USER=ota_db_bootstrap
OTA_DB_BOOTSTRAP_PASSWORD=
OTA_DB_MIGRATION_USER=ota_migration_owner
OTA_DB_MIGRATION_PASSWORD=
OTA_DB_API_USER=ota_api_app
OTA_DB_API_PASSWORD=
OTA_DB_WORKER_USER=ota_worker_app
OTA_DB_WORKER_PASSWORD=
OTA_DB_WORKER_SLOT=BLUE
OTA_DB_AUDIT_USER=ota_audit_writer
OTA_DB_AUDIT_PASSWORD=

# Non-secret workload identity metadata. Keep this UUID stable after the first
# deployment and pass the exact same variable to ota-connector-worker; its
# application.yml maps it to ota.sprint1.simulation.worker-service-principal-id.
OTA_SPRINT1_SIMULATION_WORKER_PRINCIPAL_ID=21000000-0000-4000-8000-000000000001
OTA_SPRINT1_SIMULATION_WORKER_PRINCIPAL_CODE=OTA_SPRINT1_SIMULATION_WORKER_BLUE
OTA_SPRINT1_SIMULATION_DISPATCH_DELAY=5s
OTA_SPRINT1_SIMULATION_DISPATCH_BATCH_SIZE=100
OTA_SPRINT1_SIMULATION_COLLECTION_POLL_DELAY=5s

# Mandatory runtime setting for the standalone API. Schema migration is owned
# by the one-shot ota-db-migrator service, never by an API replica.
SPRING_FLYWAY_ENABLED=false
